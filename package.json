{
  "name": "commute-app",
  "version": "1.0.0",
  "private": true,
  "description": "Commute! - save your routes, plan your trips, and get alerted about delays.",
  "scripts": {
    "start": "node functions/index.js",
    "dev": "node --watch functions/index.js",
    "build": "browserify webmap.js -o public/js/webmap.js && node -e \"require('fs').copyFileSync('node_modules/leaflet/dist/leaflet.css','public/css/leaflet.css')\"",
    "deploy": "firebase deploy --only hosting",
    "build:site": "node scripts/build-site.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "leaflet": "^1.9.2"
  },
  "devDependencies": {
    "browserify": "^17.0.0",
    "firebase-tools": "^11.16.1"
  }
}
